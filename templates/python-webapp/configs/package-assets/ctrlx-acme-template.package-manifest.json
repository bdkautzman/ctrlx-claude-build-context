{
  "$schema": "https://json-schema.boschrexroth.com/ctrlx-automation/ctrlx-os/apps/package-manifest/package-manifest.v1.7.schema.json",
  "version": "1.0.0",
  "id": "ctrlx-acme-template",
  "scopes-declaration": [
    {
      "identifier": "ctrlx-acme-template.web",
      "name": "Template App",
      "description": "Permissions for the Template App",
      "scopes": [
        {
          "identifier": "ctrlx-acme-template.web.all.r",
          "name": "View Template App",
          "description": "View: status and values of the Template App"
        },
        {
          "identifier": "ctrlx-acme-template.web.operate.x",
          "name": "Operate Template App",
          "description": "View and operate: also write runtime values and start actions of the Template App (no settings)"
        },
        {
          "identifier": "ctrlx-acme-template.web.all.rw",
          "name": "Configure Template App",
          "description": "View, operate and configure: also change the settings of the Template App"
        }
      ]
    }
  ],
  "services": {
    "proxyMapping": [
      {
        "name": "ctrlx-acme-template.web",
        "url": "/ctrlx-acme-template",
        "binding": "unix://{$SNAP_DATA}/package-run/ctrlx-acme-template/web.sock",
        "restricted": [
          "/ctrlx-acme-template/api"
        ]
      }
    ]
  },
  "menus": {
    "sidebar": [
      {
        "id": "ctrlx-acme-template",
        "title": "Template App",
        "icon": "bosch-ic-components",
        "link": "/ctrlx-acme-template/?token=${bearertoken}",
        "target": "_blank",
        "permissions": [
          "ctrlx-acme-template.web.all.r",
          "ctrlx-acme-template.web.operate.x",
          "ctrlx-acme-template.web.all.rw"
        ],
        "items": []
      }
    ],
    "overview": [
      {
        "id": "ctrlx-acme-template-overview",
        "title": "Template App",
        "description": "Web UI, Data Layer nodes and app-data settings",
        "icon": "bosch-ic-components",
        "link": "/ctrlx-acme-template/?token=${bearertoken}",
        "target": "_blank",
        "permissions": [
          "ctrlx-acme-template.web.all.r",
          "ctrlx-acme-template.web.operate.x",
          "ctrlx-acme-template.web.all.rw"
        ],
        "items": []
      }
    ]
  },
  "commands": {
    "activeConfiguration": {
      "save": [
        {
          "id": "ctrlx-acme-template",
          "subject": "Template App settings",
          "url": "/ctrlx-acme-template/api/v1/appdata/save"
        }
      ],
      "load": [
        {
          "id": "ctrlx-acme-template",
          "subject": "Template App settings",
          "url": "/ctrlx-acme-template/api/v1/appdata/load"
        }
      ]
    }
  },
  "configuration": {
    "appDirectories": [
      {
        "name": "ctrlx-acme-template",
        "description": "Template App",
        "icon": "bosch-ic-components",
        "copyOnLoad": true,
        "writeProtected": false
      }
    ],
    "appPrivateFiles": [
      "^ctrlx-acme-template/.*\\.tmp$"
    ]
  },
  "uiExtensions": {
    "dashboard": [
      {
        "order": 100,
        "src": "/ctrlx-acme-template/widgets.js",
        "tag": "ctrlx-acme-template-widget",
        "title": "Template App",
        "description": "Status and values of the Template App",
        "image": "/ctrlx-acme-template/widget.svg",
        "initialSize": {
          "cols": 3,
          "rows": 3
        },
        "minSize": {
          "cols": 3,
          "rows": 2
        },
        "maxSize": {
          "cols": 6,
          "rows": 6
        },
        "noInitialCreation": true,
        "permissions": [
          "ctrlx-acme-template.web.all.r",
          "ctrlx-acme-template.web.operate.x",
          "ctrlx-acme-template.web.all.rw"
        ],
        "categories": [
          "Apps"
        ]
      }
    ]
  }
}
