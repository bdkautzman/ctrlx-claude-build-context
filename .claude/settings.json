{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tools/check.sh *)",
      "Bash(../../tools/check.sh *)",
      "Bash(python3 tools/ctrlx_check.py *)",
      "Bash(python3 tools/new_app.py *)",
      "Bash(python3 tools/foss_from_prime.py *)",
      "Bash(python3 -m unittest *)",
      "Bash(python3 tools/ui_check.py *)",
      "Bash(python3 ../../tools/ui_check.py *)",
      "Bash(python3 tools/pdf_check.py *)",
      "Bash(tools/setup-ui-test.sh --check)",
      "Bash(./run-local.sh)",
      "Bash(./build-snap-amd64.sh)",
      "Bash(./build-snap-amd64.sh *)",
      "Bash(./build-snap-arm64.sh)",
      "Bash(./build-snap-arm64.sh *)",
      "Bash(tools/ctrlx.py --help)",
      "Bash(tools/ctrlx.py devices)",
      "Bash(tools/ctrlx.py packages)",
      "Bash(tools/ctrlx.py state)",
      "Bash(tools/ctrlx.py dl-read *)",
      "Bash(tools/ctrlx.py dl-browse *)",
      "Bash(tools/ctrlx.py appdata *)",
      "Bash(tools/ctrlx.py logs)",
      "Bash(tools/ctrlx.py logs *)",
      "Bash(tools/ctrlx.py api GET *)",
      "Bash(tools/ctrlx.py install *)",
      "Bash(tools/ctrlx.py --device * packages)",
      "Bash(tools/ctrlx.py --device * state)",
      "Bash(tools/ctrlx.py --device * dl-read *)",
      "Bash(tools/ctrlx.py --device * dl-browse *)",
      "Bash(tools/ctrlx.py --device * appdata *)",
      "Bash(tools/ctrlx.py --device * logs)",
      "Bash(tools/ctrlx.py --device * logs *)",
      "Bash(tools/ctrlx.py --device * api GET *)",
      "Bash(tools/ctrlx.py --device * install *)",
      "Bash(python3 tools/ctrlx.py --help)",
      "Bash(python3 tools/ctrlx.py devices)",
      "Bash(python3 tools/ctrlx.py packages)",
      "Bash(python3 tools/ctrlx.py state)",
      "Bash(python3 tools/ctrlx.py dl-read *)",
      "Bash(python3 tools/ctrlx.py dl-browse *)",
      "Bash(python3 tools/ctrlx.py appdata *)",
      "Bash(python3 tools/ctrlx.py logs)",
      "Bash(python3 tools/ctrlx.py logs *)",
      "Bash(python3 tools/ctrlx.py api GET *)",
      "Bash(python3 tools/ctrlx.py install *)",
      "Bash(python3 tools/ctrlx.py --device * packages)",
      "Bash(python3 tools/ctrlx.py --device * state)",
      "Bash(python3 tools/ctrlx.py --device * dl-read *)",
      "Bash(python3 tools/ctrlx.py --device * dl-browse *)",
      "Bash(python3 tools/ctrlx.py --device * appdata *)",
      "Bash(python3 tools/ctrlx.py --device * logs)",
      "Bash(python3 tools/ctrlx.py --device * logs *)",
      "Bash(python3 tools/ctrlx.py --device * api GET *)",
      "Bash(python3 tools/ctrlx.py --device * install *)"
    ],
    "ask": [
      "Bash(tools/ctrlx.py dl-write *)",
      "Bash(tools/ctrlx.py --device * dl-write *)",
      "Bash(python3 tools/ctrlx.py dl-write *)",
      "Bash(python3 tools/ctrlx.py --device * dl-write *)",
      "Edit(/templates/**)",
      "Edit(/tools/**)"
    ],
    "deny": [
      "Edit(/reference/**)",
      "Edit(/docs/ctrlx/upstream-sdk-4.6.0/**)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post_edit_check.py\""
          }
        ]
      }
    ]
  }
}
